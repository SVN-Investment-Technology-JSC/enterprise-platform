{
  "name": "@enterprise-platform/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=10.33.1 <11"
  },
  "scripts": {
    "check": "nx run-many -t lint typecheck test build --nxBail",
    "check:affected": "nx affected -t lint typecheck test build --nxBail",
    "dev": "nx run-many -t dev serve --projects=web,procedure-web,maintenance-web,api,procedure-api,maintenance-api,worker --parallel=7 --outputStyle=stream",
    "dev:api": "nx serve api",
    "dev:web": "nx dev web",
    "dev:worker": "nx serve worker",
    "dev:procedure": "nx run-many -t dev serve --projects=procedure-web,procedure-api --parallel=2 --outputStyle=stream",
    "dev:procedure-api": "nx serve procedure-api",
    "dev:procedure-web": "nx dev procedure-web",
    "dev:maintenance": "nx run-many -t dev serve --projects=maintenance-web,maintenance-api --parallel=2 --outputStyle=stream",
    "dev:maintenance-api": "nx serve maintenance-api",
    "dev:maintenance-web": "nx dev maintenance-web",
    "dev:status": "node tools/dev-health.mjs",
    "infra:up": "docker compose -f infrastructure/docker/compose.local.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/compose.local.yml down",
    "db:provision": "nx run migrator:serve:development --watch=false --inspect=false",
    "graph": "nx graph",
    "start:web": "nx start web",
    "format:check": "nx format:check",
    "format:write": "nx format:write"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@next/eslint-plugin-next": "~16.3.1",
    "@nx/devkit": "23.1.1",
    "@nx/esbuild": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "23.1.1",
    "@nx/next": "23.1.1",
    "@nx/node": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/react": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@playwright/test": "^1.37.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "~0.2.38",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "babel-jest": "~30.3.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "~16.3.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "~30.3.0",
