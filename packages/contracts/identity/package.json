{
  "name": "@enterprise-platform/contracts-identity",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@enterprise-platform/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "contracts-identity",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": ["^build"],
        "outputs": ["{projectRoot}/dist"],
        "options": { "cwd": "packages/contracts/identity", "command": "tsc --build tsconfig.lib.json" }
      }
    },
    "tags": [
      "type:contract",
      "scope:identity"
    ]
  },
  "dependencies": {
    "@enterprise-platform/contracts-tenancy": "workspace:*"
  }
}
