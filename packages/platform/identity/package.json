{
  "name": "@enterprise-platform/platform-identity",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "platform-identity",
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/jest.preset.js",
          "{workspaceRoot}/migrations/tenant/core/**/*.sql",
          {
            "env": "RBAC_TEST_ADMIN_URL"
          },
          {
            "externalDependencies": [
              "jest",
              "@nx/jest",
              "ts-jest",
              "@swc/jest"
            ]
          }
        ]
      }
    },
    "tags": [
      "type:platform",
      "scope:identity"
    ]
  },
  "dependencies": {
    "@enterprise-platform/adapter-database": "workspace:*",
    "@enterprise-platform/contracts-identity": "workspace:*",
    "@enterprise-platform/contracts-integration": "workspace:*",
    "@enterprise-platform/contracts-tenancy": "workspace:*",
    "@enterprise-platform/platform-entitlement": "workspace:*",
    "@enterprise-platform/platform-tenancy": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "jose": "^6.2.9"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
