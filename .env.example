PLATFORM_DATABASE_URL=postgresql://platform:platform@localhost:55432/platform
TENANT_DAKROSA_DATABASE_URL=postgresql://tenant:tenant@localhost:55433/dakrosa
TENANT_ANPHAT_DATABASE_URL=postgresql://tenant:tenant@localhost:55434/anphat
TENANT_MINHLONG_DATABASE_URL=postgresql://tenant:tenant@localhost:55435/minhlong
RABBITMQ_URL=amqp://platform:platform@localhost:5672
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=enterprise-platform
S3_ACCESS_KEY_ID=platform
S3_SECRET_ACCESS_KEY=platform-development-secret

# Required by the seed command. Never commit real passwords.
SEED_SUPERADMIN_PASSWORD=replace-with-a-local-secret
SEED_TENANT_ADMIN_PASSWORD=replace-with-a-local-secret

# Shared only for local service-to-service calls. Production uses mTLS/workload identity.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-local-token
PLATFORM_JWKS_URL=http://localhost:3333/api/auth/v1/jwks
PLATFORM_ACCESS_DECISION_URL=http://localhost:3333/api/platform/internal/v1/access-decisions
PLATFORM_ORGANIZATION_SNAPSHOT_URL=http://localhost:3333/api/platform/internal/v1/organization-snapshots

# Production must provide a persistent RS256 pair in PEM form.
# AUTH_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# AUTH_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
