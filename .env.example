# Local database connections
PLATFORM_DATABASE_URL=postgresql://platform:platform@localhost:55432/platform
# Local provisioning cluster for newly-created tenants. `{databaseName}` is
# replaced by the API; do not put this development credential in production.
TENANT_DATABASE_ADMIN_URL=postgresql://tenant:tenant@localhost:55436/postgres
TENANT_DATABASE_URL_TEMPLATE=postgresql://tenant:tenant@localhost:55436/{databaseName}

# Web
WEB_APP_URL=http://localhost:3002

# Messaging
RABBITMQ_URL=amqp://platform:platform@localhost:5672
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# Valkey and realtime notifications
VALKEY_PASSWORD=valkey_local_2026
VALKEY_URL=redis://realtime:valkey_local_2026@localhost:56379
REALTIME_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3002
REALTIME_DELIVERY_ENABLED=true
REALTIME_MUTATIONS_ENABLED=true
NOTIFICATION_CONSUMER_ENABLED=true

# Tenant deletion and upload lifecycle
# See docs/operations/tenant-deletion.md before enabling deletion.
TENANT_DELETION_ENABLED=false
TENANT_DATABASE_ENDPOINT_ALIASES=
TENANT_DATABASE_PROTECTED_NAMES=
TENANT_DELETION_QUEUES=maintenance.integrations.v1,enterprise.events.dead
TENANT_UPLOAD_DEADLINE_ENFORCED=false
TENANT_UPLOAD_MAX_DURATION_SECONDS=

# Object storage
S3_INTERNAL_ENDPOINT=http://localhost:9010
S3_PUBLIC_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=enterprise-platform
S3_ACCESS_KEY_ID=platform
S3_SECRET_ACCESS_KEY=platform-development-secret

# Authentication and service authorization
# Shared only for local service-to-service calls. Production uses mTLS/workload identity.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-local-token
AUTH_COOKIE_SECURE=false
PLATFORM_JWKS_URL=http://localhost:3333/api/auth/v1/jwks
PLATFORM_ACCESS_DECISION_URL=http://localhost:3333/api/platform/internal/v1/access-decisions

# Internal service endpoints
TENANT_CORE_ORGANIZATION_CONTEXT_URL=http://localhost:3333/api/platform/internal/v1/organization-contexts
PLATFORM_TENANT_DATABASE_API_URL=http://localhost:3333/api/platform/internal/v1/tenant-databases
INVENTORY_API_URL=http://localhost:3336/api/inventory
PROCEDURE_API_URL=http://localhost:3334/api/procedure
HRM_API_URL=http://localhost:3339/api/hrm

# Workspace
# Múi giờ để cắt "hôm nay" và "tuần này" ở Workspace, cho tới khi nền tảng lưu múi giờ theo tenant.
WORKSPACE_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Platform administrator seed
# Required to bootstrap the Platform Super Admin. Never commit real passwords.
SEED_SUPERADMIN_PASSWORD=replace-with-a-local-secret

# Production must provide a persistent RS256 pair in PEM form.
# AUTH_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# AUTH_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
