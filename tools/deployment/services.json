{
  "imageRepository": "enterprise-platform",
  "services": [
    {
      "id": "api",
      "dockerfile": "apps/api/Dockerfile"
    },
    {
      "id": "procedure-api",
      "dockerfile": "apps/procedure-api/Dockerfile"
    },
    {
      "id": "maintenance-api",
      "dockerfile": "apps/maintenance-api/Dockerfile"
    },
    {
      "id": "inventory-api",
      "dockerfile": "apps/inventory-api/Dockerfile"
    },
    {
      "id": "hrm-api",
      "dockerfile": "apps/hrm-api/Dockerfile"
    },
    {
      "id": "workspace-api",
      "dockerfile": "apps/workspace-api/Dockerfile"
    },
    {
      "id": "realtime-api",
      "dockerfile": "apps/realtime-api/Dockerfile",
      "runtimeCheck": {
        "nodeModules": ["redis", "socket.io", "tslib"]
      }
    },
    {
      "id": "notification-worker",
      "dockerfile": "apps/notification-worker/Dockerfile",
      "runtimeCheck": {
        "nodeModules": ["@prometheus-io/client", "tslib"]
      }
    },
    {
      "id": "worker",
      "dockerfile": "apps/worker/Dockerfile",
      "runtimeCheck": {
        "nodeModules": ["pg", "amqplib", "tslib"]
      }
    },
    {
      "id": "migrator",
      "dockerfile": "apps/migrator/Dockerfile"
    },
    {
      "id": "web",
      "dockerfile": "apps/web/Dockerfile",
      "runtimeCheck": {
        "nodeModules": ["@swc/helpers/esm/_interop_require_default.js"]
      }
    },
    {
      "id": "procedure-web",
      "dockerfile": "apps/procedure-web/Dockerfile",
      "runtimeCheck": {
        "nodeModules": ["@swc/helpers/esm/_interop_require_default.js"]
      }
    },
    {
      "id": "maintenance-web",
      "dockerfile": "apps/maintenance-web/Dockerfile",
      "runtimeCheck": {
        "nodeModules": ["@swc/helpers/esm/_interop_require_default.js"]
      }
    },
    {
      "id": "inventory-web",
      "dockerfile": "apps/inventory-web/Dockerfile",
      "runtimeCheck": {
        "nodeModules": ["@swc/helpers/esm/_interop_require_default.js"]
      }
    },
    {
      "id": "hrm-web",
      "dockerfile": "apps/hrm-web/Dockerfile",
      "runtimeCheck": {
        "nodeModules": ["@swc/helpers/esm/_interop_require_default.js"]
      }
    },
    {
      "id": "workspace-web",
      "dockerfile": "apps/workspace-web/Dockerfile",
      "runtimeCheck": {
        "nodeModules": ["@swc/helpers/esm/_interop_require_default.js"]
      }
    },
    {
      "id": "gateway",
      "dockerfile": "infrastructure/nginx/Dockerfile"
    }
  ]
}
