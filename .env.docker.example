# Local Docker Compose only. These are reproducible development credentials,
# not production secrets. Copy this file to .env.docker and customize it.
GATEWAY_PORT=8080

PLATFORM_DB_PASSWORD=platform_local_2026
TENANT_DB_PASSWORD=tenant_local_2026
RABBITMQ_PASSWORD=rabbit_local_2026
MINIO_ROOT_USER=platform
MINIO_ROOT_PASSWORD=minio_local_2026

SEED_SUPERADMIN_PASSWORD=ChangeMe-Docker-Superadmin-123
INTERNAL_SERVICE_TOKEN=local-internal-service-token-change-before-sharing

# false is required for the local HTTP gateway. Production HTTPS must use true.
AUTH_COOKIE_SECURE=false

# Cặp khoá RS256 cố định. Bỏ trống thì Platform Core sinh khoá mới mỗi lần khởi
# động, và các module API trả 401 "Access token không hợp lệ" cho tới khi chúng
# được restart theo. Sinh khoá cho máy mình:
#
#   node -e "const{generateKeyPairSync}=require('node:crypto');const k=generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('AUTH_PRIVATE_KEY='+k.privateKey.trim().replace(/\n/g,'\\n'));console.log('AUTH_PUBLIC_KEY='+k.publicKey.trim().replace(/\n/g,'\\n'))"
#
# AUTH_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# AUTH_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
