# Local Docker Compose only. These are reproducible development credentials,
# not production secrets. Copy this file to .env.docker and customize it.
GATEWAY_PORT=8080

PLATFORM_DB_PASSWORD=platform_local_2026
TENANT_DB_PASSWORD=tenant_local_2026
RABBITMQ_PASSWORD=rabbit_local_2026
MINIO_ROOT_USER=platform
MINIO_ROOT_PASSWORD=minio_local_2026

SEED_SUPERADMIN_PASSWORD=ChangeMe-Docker-Superadmin-123
SEED_TENANT_ADMIN_PASSWORD=ChangeMe-Docker-Tenant-123
INTERNAL_SERVICE_TOKEN=local-internal-service-token-change-before-sharing

# false is required for the local HTTP gateway. Production HTTPS must use true.
AUTH_COOKIE_SECURE=false
