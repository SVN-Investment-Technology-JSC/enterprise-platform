{
  "name": "@enterprise-platform/maintenance-api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "maintenance-api-e2e",
    "tags": [
      "type:e2e",
      "scope:maintenance"
    ],
    "implicitDependencies": [
      "maintenance-api"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "maintenance-api:build",
          "maintenance-api:serve"
        ],
        "options": {
          "jestConfig": "apps/maintenance-api-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  }
}
