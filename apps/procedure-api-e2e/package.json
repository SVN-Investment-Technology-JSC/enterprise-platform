{
  "name": "@enterprise-platform/procedure-api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "procedure-api-e2e",
    "implicitDependencies": [
      "procedure-api"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "procedure-api:build",
          "procedure-api:serve"
        ],
        "options": {
          "jestConfig": "apps/procedure-api-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    },
    "tags": ["type:e2e", "scope:procedure-engine"]
  }
}
