{
  "name": "@enterprise-platform/video-worker",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "video-worker",
    "targets": {
      "build": {
        "dependsOn": [
          "typecheck",
          "^typecheck"
        ],
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/video-worker/dist",
          "format": [
            "cjs"
          ],
          "bundle": true,
          "thirdParty": false,
          "main": "apps/video-worker/src/main.ts",
          "tsConfig": "apps/video-worker/tsconfig.app.json",
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/video-worker/dist/package.json",
          "{workspaceRoot}/apps/video-worker/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/video-worker/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "video-worker:build",
          "runBuildTargetDependencies": false,
          "inspect": false
        },
        "configurations": {
          "development": {
            "buildTarget": "video-worker:build:development",
            "buildTargetOptions": {
              "outputPath": ".nx/video-worker-dev",
              "esbuildOptions": {
                "outfile": ".nx/video-worker-dev/main.js",
                "sourcemap": true,
                "outExtension": {
                  ".js": ".js"
                }
              }
            }
          },
          "production": {
            "buildTarget": "video-worker:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    },
    "tags": [
      "type:app",
      "scope:backend"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@enterprise-platform/adapter-database": "workspace:*",
    "@enterprise-platform/adapter-events": "workspace:*",
    "@enterprise-platform/adapter-storage": "workspace:*",
    "@enterprise-platform/contracts-integration": "workspace:*",
    "@enterprise-platform/contracts-social": "workspace:*",
    "@enterprise-platform/contracts-tenancy": "workspace:*",
    "@enterprise-platform/module-social": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "amqplib": "^2.0.1",
    "pg": "^8.23.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0"
  }
}
