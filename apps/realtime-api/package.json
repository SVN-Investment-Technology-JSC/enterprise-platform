{
  "name": "@enterprise-platform/realtime-api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "realtime-api",
    "tags": [
      "type:app",
      "scope:realtime"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "env": {
            "NODE_ENV": "production"
          },
          "cwd": "apps/realtime-api"
        },
        "configurations": {
          "development": {
            "env": {
              "NODE_ENV": "development"
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/realtime-api/dist/package.json",
          "{workspaceRoot}/apps/realtime-api/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/realtime-api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "realtime-api:build",
          "runBuildTargetDependencies": false,
          "inspect": false
        },
        "configurations": {
          "development": {
            "buildTarget": "realtime-api:build-watch"
          },
          "production": {
            "buildTarget": "realtime-api:build:production"
          }
        }
      },
      "load": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/realtime-load.mjs",
          "cwd": "apps/realtime-api"
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "build-watch": {
        "executor": "@nx/webpack:webpack",
        "options": {
          "webpackConfig": "apps/realtime-api/webpack.config.js",
          "outputPath": "apps/realtime-api/dist",
          "outputFileName": "main.js",
          "target": "node",
          "tsConfig": "apps/realtime-api/tsconfig.app.json"
        }
      }
    }
  },
  "dependencies": {
    "@enterprise-platform/adapter-database": "workspace:*",
    "@enterprise-platform/adapter-events": "workspace:*",
    "@enterprise-platform/contracts-identity": "workspace:*",
    "@enterprise-platform/contracts-integration": "workspace:*",
    "@enterprise-platform/contracts-realtime": "workspace:*",
    "@enterprise-platform/contracts-tenancy": "workspace:*",
    "@enterprise-platform/module-notifications": "workspace:*",
    "@enterprise-platform/platform-module-access": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/websockets": "^11.2.1",
    "@prometheus-io/client": "^0.16.1",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "cookie": "^2.0.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "5.0.6",
    "@types/pg": "8.21.0",
    "socket.io-client": "^4.8.4"
  }
}
