{
  "name": "@enterprise-platform/workspace-api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "workspace-api",
    "targets": {
      "build": {
        "dependsOn": ["typecheck", "^typecheck"],
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "env": { "NODE_ENV": "production" },
          "cwd": "apps/workspace-api"
        },
        "configurations": {
          "development": { "env": { "NODE_ENV": "development" } }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": ["build"],
        "options": {
          "buildTarget": "workspace-api:build",
          "runBuildTargetDependencies": false,
          "inspect": false
        },
        "configurations": {
          "development": { "buildTarget": "workspace-api:build:development" },
          "production": { "buildTarget": "workspace-api:build:production" }
        }
      },
      "test": {
        "options": { "passWithNoTests": true }
      },
      "prune-lockfile": {
        "dependsOn": ["build"],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/workspace-api/dist/package.json",
          "{workspaceRoot}/apps/workspace-api/dist/pnpm-lock.yaml"
        ],
        "options": { "buildTarget": "build" }
      },
      "copy-workspace-modules": {
        "dependsOn": ["build"],
        "cache": true,
        "outputs": ["{workspaceRoot}/apps/workspace-api/dist/workspace_modules"],
        "executor": "@nx/js:copy-workspace-modules",
        "options": { "buildTarget": "build" }
      },
      "prune": {
        "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
        "executor": "nx:noop"
      }
    },
    "tags": ["type:app", "scope:workspace"]
  },
  "dependencies": {
    "@enterprise-platform/adapter-database": "workspace:*",
    "@enterprise-platform/contracts-identity": "workspace:*",
    "@enterprise-platform/contracts-tenancy": "workspace:*",
    "@enterprise-platform/module-workspace": "workspace:*",
    "@enterprise-platform/platform-module-access": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "jose": "^6.2.9",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6"
  }
}
